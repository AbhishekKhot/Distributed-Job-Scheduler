# Variables read by deploy/compose/docker-compose.yml.
# Do not fill this file in. Run `make env`, which writes deploy/compose/.env (gitignored)
# with random values from a CSPRNG.
POSTGRES_PASSWORD=
KAIROS_DB_OWNER_PASSWORD=
KAIROS_DB_APP_PASSWORD=
KAIROS_REDIS_PASSWORD=
KAFKA_CLUSTER_ID=
GRAFANA_ADMIN_PASSWORD=
# Optional: host port for the API (bound to 127.0.0.1 only).
KAIROS_API_PORT=8080
