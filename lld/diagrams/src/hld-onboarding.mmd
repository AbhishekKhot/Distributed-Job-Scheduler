flowchart TB
  classDef svc fill:#a5d8ff
  classDef db fill:#b2f2bb
  classDef bus fill:#ffec99
  classDef ext fill:#ffc9c9
  classDef cache fill:#d0bfff
  classDef grey fill:#e9ecef
  subgraph A["1. Account"]
    direction LR
    A1["Sign up<br/>company email + password"]:::svc --> A2["Verify email<br/>one-time link"]:::svc --> A3["Log in<br/>access + refresh token"]:::svc
  end
  subgraph B["2. Organization"]
    direction LR
    B1["Create organization<br/>creator becomes OWNER"]:::db --> B2["Invite members<br/>with roles"]:::db --> B3["Create API keys<br/>for automation"]:::db
  end
  subgraph C["3. Connectivity"]
    direction LR
    C1["Add egress rule<br/>host, suffix or CIDR"]:::cache --> C2["Prove ownership or<br/>get platform approval"]:::cache --> C3["Store secrets and<br/>CA bundles"]:::cache
  end
  subgraph D["4. Scheduling"]
    direction LR
    D1["Register API endpoint<br/>and test it"]:::ext --> D2["Create jobs:<br/>immediate, one-time,<br/>cron, interval"]:::ext --> D3["Create workflows:<br/>DAG of tasks"]:::ext
  end
  A --> B
  B --> C
  C --> D
