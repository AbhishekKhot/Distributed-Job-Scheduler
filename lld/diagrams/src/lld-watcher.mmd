flowchart LR
  classDef svc fill:#a5d8ff
  classDef db fill:#b2f2bb
  classDef bus fill:#ffec99
  classDef ext fill:#ffc9c9
  classDef cache fill:#d0bfff
  classDef grey fill:#e9ecef
  SL["ShardLeaseManager<br/>every 5s, per cell"]:::svc
  FP["FirePoller<br/>about 1s per shard group"]:::svc
  DP["DelayedPoller<br/>about 1s"]:::svc
  REL["OutboxRelay<br/>about 100 ms per shard group"]:::svc
  LS["LeaseSweeper<br/>5s"]:::svc
  SQ["StuckQueuedSweeper<br/>60s"]:::svc
  WL["WakeupListener<br/>LISTEN"]:::grey
  RFM["RedisFailoverMonitor"]:::grey
  DB[("cell DB<br/>run_inflight + outbox")]:::db
  RD[("Redis")]:::cache
  K[["Kafka"]]:::bus
  SL --> FP
  SL --> DP
  SL --> REL
  SL --> LS
  SL --> SQ
  WL -->|"nudge"| FP
  FP -->|"runs + outbox rows"| DB
  DP -->|"runs + outbox rows"| DB
  LS -->|"settle + outbox rows"| DB
  LS -.->|"lock and marker checks"| RD
  RFM -.->|"quarantine flag"| LS
  DB --> REL
  REL -->|"publish, then delete"| K
