flowchart TB
  classDef svc fill:#a5d8ff
  classDef db fill:#b2f2bb
  classDef bus fill:#ffec99
  classDef ext fill:#ffc9c9
  classDef cache fill:#d0bfff
  classDef grey fill:#e9ecef
  subgraph A["Schedule and dispatch"]
    direction LR
    A1["1. Watcher claims due<br/>schedules in its shards"]:::svc --> A2[("cell DB: run row +<br/>outbox row, one tx")]:::db --> A3["2. Outbox relay<br/>publishes when due"]:::svc --> A4[["Kafka run.tier"]]:::bus
  end
  subgraph B["Execute"]
    direction LR
    B1["3. Redis run lock"]:::cache --> B2["4. Fenced claim<br/>in the cell DB"]:::db --> B3["5. Sent marker,<br/>then HTTPS call"]:::ext --> B4[["Kafka run.result"]]:::bus
  end
  subgraph C["Settle"]
    direction LR
    C1["6. State processor<br/>settles the batch"]:::svc --> C2[("cell DB: history,<br/>retry or DLQ, next<br/>workflow steps, outbox")]:::db --> C3["7. Executor releases<br/>the run lock"]:::cache
  end
  A --> B
  B --> C
